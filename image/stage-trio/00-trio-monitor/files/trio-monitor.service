[Unit]
Description=Trio Monitor glucose display
# An appliance display must never stop retrying.
StartLimitIntervalSec=0

[Service]
Type=simple
User=trio
Group=trio
SupplementaryGroups=video render input netdev
WorkingDirectory=/opt/trio-monitor
ExecStart=/usr/bin/python3 -m trio_monitor --config /home/trio/config.json
Restart=always
RestartSec=3
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
