[Unit]
Description=Trio Monitor glucose display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trio
Group=trio
SupplementaryGroups=video render input netdev
WorkingDirectory=/opt/trio-monitor
ExecStart=/usr/bin/python3 -m trio_monitor --config /home/trio/config.json
Restart=always
RestartSec=3
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
